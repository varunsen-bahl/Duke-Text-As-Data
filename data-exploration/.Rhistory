text_tbl <- tibble(
file = basename(all_files),
doc_id = name_map[file],
text = sapply(all_files, read_file, USE.NAMES = FALSE)
)
# ---------------------
# II - Preprocessing
# ---------------------
# 1: Normalization (with backup)
replacements <- c(
"ſ" = "s",
"vpon" = "upon"
)
text_tbl <- text_tbl %>%
mutate(text_clean = text %>%
str_replace_all(replacements) %>%
str_replace_all("2dly", "secondly") %>%
